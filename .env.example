# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Put data on a persistent disk. Do not point this to a public web directory.
TOASTCORD_DATA_DIR=./data
# Optional WebRTC relay for networks where direct P2P is blocked.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Set true when HTTPS terminates at the app or trusted reverse proxy.
COOKIE_SECURE=false
